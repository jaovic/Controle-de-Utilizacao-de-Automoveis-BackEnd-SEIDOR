        {
          "name": "Cadastrar automóvel",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const L = () => String.fromCharCode(65 + Math.floor(Math.random() * 26));",
                  "const D = () => Math.floor(Math.random() * 10);",
                  "pm.collectionVariables.set('plate', L() + L() + L() + D() + L() + D() + D());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('carId', pm.response.json().id);"
                ]
              }
            }
